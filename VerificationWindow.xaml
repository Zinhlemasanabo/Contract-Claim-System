<Window x:Class="ContractClaimSystem.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claim Verification" Height="500" Width="800"
        WindowStartupLocation="CenterScreen" Background="#FDFEFE">

    <Grid Margin="20">
        <TextBlock Text="Claims Verification" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <DataGrid x:Name="ClaimsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,40,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Lecturer" Binding="{Binding LecturerName}" Width="*"/>
                <DataGridTextColumn Header="Hours" Binding="{Binding HoursWorked}" Width="Auto"/>
                <DataGridTextColumn Header="Rate" Binding="{Binding HourlyRate}" Width="Auto"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="Auto"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                <DataGridTemplateColumn Header="Actions" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Approve" Background="#27AE60" Foreground="White"
                                        Margin="5,0" Width="70" Click="Approve_Click"/>
                                <Button Content="Reject" Background="#C0392B" Foreground="White"
                                        Margin="5,0" Width="70" Click="Reject_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>