<Window x:Class="ContractClaimSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contract Monthly Claim System" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#ECF0F1">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Lecturer Claim Submission"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,20"/>

		<StackPanel Grid.Row="1" Orientation="Vertical" Width="400" HorizontalAlignment="Left">

			<!-- Use initial Text as a simple placeholder -->
			<TextBox x:Name="txtName" Margin="0,5" Text="Enter Lecturer Name" Foreground="Gray"
                     GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
			<TextBox x:Name="txtHours" Margin="0,5" Text="Enter Hours Worked" Foreground="Gray"
                     GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
			<TextBox x:Name="txtRate" Margin="0,5" Text="Enter Hourly Rate" Foreground="Gray"
                     GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
			<TextBox x:Name="txtNotes" Margin="0,5" Text="Enter Additional Notes" Foreground="Gray"
                     GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>

			<StackPanel Orientation="Horizontal" Margin="0,10">
				<Button x:Name="btnUploadFile" Content="Upload File" Width="120"
                        Click="BtnUpload_Click" Background="#2980B9" Foreground="White"/>
				<TextBlock x:Name="txtFilePath" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="No file uploaded"/>
			</StackPanel>

			<Button x:Name="btnSubmit" Content="Submit Claim" Width="150" Height="40"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"
                    Click="BtnSubmit_Click"/>

			<Label x:Name="lblStatus" Content="Status: Pending"
                   Foreground="#2C3E50" Margin="0,20,0,0" FontWeight="Bold"/>

			<Separator Margin="0,20"/>

			<TextBlock Text="My Submitted Claims" FontSize="16" FontWeight="Bold" Margin="0,10"/>
			<DataGrid x:Name="LecturerClaimsGrid" AutoGenerateColumns="False"
                      Height="250" IsReadOnly="True">
				<DataGrid.Columns>
					<DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
					<DataGridTextColumn Header="Hours" Binding="{Binding HoursWorked}"/>
					<DataGridTextColumn Header="Rate" Binding="{Binding HourlyRate}"/>
					<DataGridTextColumn Header="Total" Binding="{Binding Total}"/>
					<DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
				</DataGrid.Columns>
			</DataGrid>
		</StackPanel>

		<Button Content="Open Verification Window"
                Grid.Row="1" HorizontalAlignment="Right" Width="200"
                Background="#8E44AD" Foreground="White" Height="40"
                Click="BtnOpenVerification_Click"/>
	</Grid>
</Window>
